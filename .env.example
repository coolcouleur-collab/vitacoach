# ─── Groq ───────────────────────────────────────────────────────────────────
# Clé API Groq pour les appels LLM
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Supabase ────────────────────────────────────────────────────────────────
# URL du projet Supabase (ex: https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Clé publique anonyme Supabase
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxx

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Clé secrète Stripe (commence par sk_live_ ou sk_test_)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_EMAIL=mailto:contact@meet-solenn.com

# ─── Serveur ─────────────────────────────────────────────────────────────────
# Port d'écoute du backend (défaut : 3001)
PORT=3001

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# URL du backend en production (utilisée par le frontend Vercel)
# Laisser vide en dev local (le proxy Vite prend le relais)
VITE_API_URL=https://solenn-api.onrender.com
