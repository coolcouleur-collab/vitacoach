<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>


        <service
            android:name=".CourseService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

    <!-- ─── Permissions ──────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Push Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Google Fit / Health Connect -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <!-- READ_DISTANCE retire le 2026-08-30 : jamais lu. syncHealthData ne
         renvoie que les pas, la frequence cardiaque et le sommeil.
         Google lit CE manifeste pour generer la declaration Health Connect de
         la console : toute permission en trop devient une donnee declaree que
         l'app ne consulte pas, ce qui est du data overreach et un motif de
         rejet. Ces trois lignes doivent rester alignees sur HEALTH_READ_TYPES
         dans src/hooks/useCapacitor.js. -->

    <!-- Localisation pour météo -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- FINE et pas seulement COARSE. La localisation grossiere donne une
         precision de l'ordre du kilometre : le filtre de distance rejetait
         chaque point, et la distance d'une course serait restee a zero pour
         toujours sur Android. Ce n'est pas un raffinement, c'est ce qui fait
         marcher la mesure. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Le service de premier plan, qui garde la course vivante ecran
         verrouille et l'affiche sur l'ecran de veille. Depuis Android 14 son
         type doit etre declare, ici et sur le service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Le plugin @capacitor/local-notifications declare SCHEDULE_EXACT_ALARM
         dans SON manifeste, qui se fond dans le notre a la compilation. Google
         examine cette permission et attend une justification : reveils,
         minuteurs, rendez-vous a la seconde pres. Des rappels de bien-etre ne
         la justifient pas, et un rappel qui arrive a 18h03 au lieu de 18h00
         ne gene personne. On la retire donc du paquet, et les notifications
         sont posees avec isExactNotification a false, pour que le plugin ne
         la demande pas non plus a l'execution. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- Sans cette declaration, getSdkStatus repond « indisponible » meme
         quand Health Connect est installe : depuis Android 11, une app ne voit
         que les paquets qu'elle a declares. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.connect.action.HEALTH_CONNECT_SETTINGS" />
        </intent>
    </queries>

</manifest>
